{
  "name": "retail-intelligence-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Digital UP Board Stage 1 backend: Vercel Functions + Supabase PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
