# Digital UP Board backend - server-side configuration only.
# Copy to .env.local (never commit real values). None of these may be exposed
# to the browser bundle; the frontend asks the operator for the token at runtime.

# Supabase project used by SupabaseGateway (PostgREST RPC).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared operator token expected in "Authorization: Bearer <token>".
DEMO_OPERATOR_TOKEN=

# Optional, local development / tests only: direct PostgreSQL connection.
# When set, the API calls the same SQL functions through node-postgres instead
# of Supabase PostgREST. Leave empty in Vercel deployments.
DATABASE_URL=

# Optional: port for the local dev server (scripts/dev-server.ts). Default 3000.
PORT=
